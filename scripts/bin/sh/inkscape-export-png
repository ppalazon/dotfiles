#!/usr/bin/env bash

set -euo pipefail

AREA="page-drawing"
DPI="96"
PAGE="all"
MARGIN=""
SUFFIX=""
EXPORT_WIDTH=""
EXPORT_HEIGHT=""
SCRIPT_NAME="$(basename "$0")"

usage() {
  cat <<EOF
Usage:
  $SCRIPT_NAME [options] <input_file> <output_dir>

Options:
  --page N|all
  --area page|drawing|page-drawing
  --dpi DPI
  --width PX
  --height PX
  --margin VALUE
  --suffix NAME
  -h, --help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --page)
      PAGE="$2"
      shift 2
      ;;
    --area)
      AREA="$2"
      shift 2
      ;;
    --dpi)
      DPI="$2"
      shift 2
      ;;
    --margin)
      MARGIN="$2"
      shift 2
      ;;
    --suffix)
      SUFFIX="$2"
      shift 2
      ;;
    --width)
      EXPORT_WIDTH="$2"
      shift 2
      ;;
    --height)
      EXPORT_HEIGHT="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1"
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -eq 2 ]] || { usage; exit 1; }

INPUT_FILE="$1"
OUTPUT_DIR="$2"

command -v inkscape >/dev/null || {
  echo "Inkscape is not installed"
  exit 1
}

command -v xmlstarlet >/dev/null || {
  echo "xmlstarlet is not installed"
  exit 1
}

[[ -z "$EXPORT_WIDTH" || -z "$EXPORT_HEIGHT" ]] || {
  echo "Specify only one of --width or --height"
  exit 1
}

mkdir -p "$OUTPUT_DIR"

INPUT_STEM=$(basename "$INPUT_FILE" .svg)
OUTPUT_SUFFIX="${SUFFIX:+-$SUFFIX}"

build_png_args() {
  if [[ -n "$EXPORT_WIDTH" ]]; then
    echo "--export-width=$EXPORT_WIDTH"
  elif [[ -n "$EXPORT_HEIGHT" ]]; then
    echo "--export-height=$EXPORT_HEIGHT"
  else
    echo "--export-dpi=$DPI"
  fi
}

mapfile -t PNG_ARGS < <(build_png_args)

export_page() {
  local page_number="$1"
  local page_label="$2"

  local output_file="${OUTPUT_DIR}/${INPUT_STEM}-${page_label}${OUTPUT_SUFFIX}.png"

  if [[ "$AREA" == "page-drawing" ]]; then
    local tmp_svg
    tmp_svg="$(mktemp --suffix=.svg)"

    inkscape "$INPUT_FILE" \
      --export-type=svg \
      --export-filename="$tmp_svg" \
      --export-page="$page_number"

    inkscape "$tmp_svg" \
      --export-type=png \
      --export-filename="$output_file" \
      --export-area-drawing \
      "${PNG_ARGS[@]}"

    rm -f "$tmp_svg"
  else
    inkscape "$INPUT_FILE" \
      --export-type=png \
      --export-filename="$output_file" \
      --export-page="$page_number" \
      "${PNG_ARGS[@]}"
  fi

  if [[ -n "$MARGIN" ]]; then
    local tmp_png
    tmp_png="$(mktemp --suffix=.png)"

    convert "$output_file" \
      -bordercolor none \
      -border "$MARGIN" \
      "$tmp_png"

    mv "$tmp_png" "$output_file"
  fi
}

if [[ "$PAGE" != "all" ]]; then
  export_page "$PAGE" "page${PAGE}"
  exit 0
fi

mapfile -t pages < <(
  xmlstarlet sel \
    -N inkscape="http://www.inkscape.org/namespaces/inkscape" \
    -t \
    -m "//inkscape:page" \
    -v "@id" -o "|" -v "@inkscape:label" -n \
    "$INPUT_FILE"
)

for i in "${!pages[@]}"; do
  page="${pages[$i]}"
  export_page "$((i + 1))" "${page#*|}"
done