#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

usage() {
  cat <<EOF
Usage:
  $SCRIPT_NAME <source.svg> <output_dir> [suffix]

Arguments:
  source.svg   Source SVG file.
  output_dir   Output directory.
  suffix       Optional suffix (e.g. light, dark).

Examples:
  $SCRIPT_NAME logo.svg export
  $SCRIPT_NAME logo-light.svg export light
  $SCRIPT_NAME logo-dark.svg export dark
EOF
}

if [[ $# -lt 2 || $# -gt 3 ]]; then
  usage
  exit 1
fi

SOURCE_SVG="$1"
EXPORT_DIR="$2"
SUFFIX="${3:-}"

FAVICON_DIR="${EXPORT_DIR}/img/favicon"

mkdir -p "${FAVICON_DIR}"

# Optional filename suffix
if [[ -n "$SUFFIX" ]]; then
  SUFFIX="-$SUFFIX"
fi

echo "Generating favicon assets from ${SOURCE_SVG}..."

generate_png() {
  local size="$1"
  local name="$2"

  magick "${SOURCE_SVG}" \
    -background none \
    -resize "${size}x${size}" \
    "${FAVICON_DIR}/${name}${SUFFIX}.png"
}

# Standard favicons
generate_png 16  "favicon-16x16"
generate_png 32  "favicon-32x32"
generate_png 48  "favicon-48x48"

# Apple touch icon
generate_png 180 "apple-touch-icon"

# Android / PWA
generate_png 192 "android-chrome-192x192"
generate_png 512 "android-chrome-512x512"

# Multi-resolution ICO
magick "${SOURCE_SVG}" \
  -define icon:auto-resize=16,32,48 \
  "${EXPORT_DIR}/favicon${SUFFIX}.ico"

# Optimized SVG favicon
svgo \
  -i "${SOURCE_SVG}" \
  -o "${EXPORT_DIR}/favicon${SUFFIX}.svg" \
  --multipass >/dev/null 2>&1

echo "Done."