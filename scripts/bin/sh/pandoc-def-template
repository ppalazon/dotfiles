#!/bin/bash
set -eou pipefail

PANDOC_TYPE=${1:-}
OUTPUT_FILE=${2:-}

# Check if PANDOC_TYPE is provided and output file is provided
if [ -z "$PANDOC_TYPE" ] || [ -z "$OUTPUT_FILE" ]; then
  echo "Usage: $(basename $0) <template-type> <output-file>"
  exit 1
fi

DOTFILES_DIR="$HOME/dotfiles/editors/.pandoc/templates"

pandoc --print-default-template="$PANDOC_TYPE" > "$DOTFILES_DIR/$OUTPUT_FILE"